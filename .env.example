# Copy to .env.local. Names only — never commit real values.

# Postgres connection used by the server (Next.js server components/actions, worker).
# Local: the dev database created by `npm run db:reset`.
# Supabase: the pooled connection string of the project (role `postgres`).
DATABASE_URL=

# Canonical public origin for storefront URLs, canonical tags, sitemap and JSON-LD.
SITE_URL=

# Supabase project (used for Auth + Storage once the console is connected; not needed for the public storefront).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/worker only. Must never be exposed to the browser or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider for step 3 (image analysis). Leave empty to use the labelled mock adapter.
ANTHROPIC_API_KEY=
