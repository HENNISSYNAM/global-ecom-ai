# Copy to .env.local. Names only — never commit real values.

# Postgres connection used by the server (Next.js server components/actions, worker).
# Local: the dev database created by `npm run db:reset`.
# Supabase: the pooled connection string of the project (role `postgres`).
DATABASE_URL=

# Canonical public origin for storefront URLs, canonical tags, sitemap and JSON-LD.
SITE_URL=

# Supabase project: Auth (seller sign-in) and Storage (photos). Without them in development, photos go to data/local-storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/worker only. Must never be exposed to the browser or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Storefront chat assistant. Option A: any OpenAI-compatible gateway (all three required), e.g. a Vietnamese AI gateway.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Option B: Anthropic (Claude). Used when the three AI_* variables above are not all set.
# With neither configured, the chat falls back to a keyword lookup that labels itself as not AI.
ANTHROPIC_API_KEY=
# Optional: a separate vision-capable model for photo analysis on the same gateway (defaults to AI_MODEL).
AI_VISION_MODEL=

# Seller console photo analysis jobs: Vercel Cron calls /api/cron/ai-jobs with this bearer secret (recovery sweep).
CRON_SECRET=

# Local development only: DEV_AUTH=1 enables a "sign in as seeded user" page when Supabase Auth is not configured.
# Ignored in production and whenever NEXT_PUBLIC_SUPABASE_URL/ANON_KEY are set.
DEV_AUTH=
